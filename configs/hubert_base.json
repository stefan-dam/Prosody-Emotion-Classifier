{
  "model_name": "superb/hubert-base-superb-er",
  "sample_rate": 16000,
  "max_seconds": 5,
  "batch_size": 32,
  "gradient_accumulation_steps": 1,
  "learning_rate": 1e-5,
  "epochs": 50,
  "evaluation_strategy": "steps",
  "save_strategy": "steps",
  "save_steps": 500,
  "eval_steps": 500,
  "logging_steps": 20,
  "use_weighted_layer_sum": true,
  "classifier_proj_size": 256,
  "apply_spec_augment": true,
  "mask_time_prob": 0.05,
  "mask_time_length": 10,
  "mask_time_min_masks": 2,
  "mask_feature_prob": 0.0,
  "mask_feature_length": 10,
  "mask_feature_min_masks": 0,
  "random_crop": true,
  "use_augment": true,
  "augment": {
    "gain_prob": 0.3,
    "gain_db_range": 2.0,
    "noise_prob": 0.3,
    "noise_snr_db": 30.0
  },
  "freeze_feature_extractor_steps": 500,
  "keep_best_n": 3,
  "checkpoint_metric": "eval_accuracy",
  "load_best_model_at_end": true,
  "balance_datasets": true,
  "seed": 42,
  "log_path": "train.log",
  "label_set": ["neutral","happy","angry","sad","disgust","fear","excited"]
}
