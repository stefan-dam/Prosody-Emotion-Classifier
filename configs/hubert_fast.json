{
  "model_name": "superb/hubert-base-superb-er",
  "sample_rate": 16000,
  "max_seconds": 5,
  "batch_size": 32,
  "gradient_accumulation_steps": 1,
  "learning_rate": 5e-5,
  "fp16": false,
  "gradient_checkpointing": false,
  "epochs": 1,
  "max_steps": 40000,
  "evaluation_strategy": "steps",
  "save_strategy": "steps",
  "save_steps": 2000,
  "eval_steps": 2000,
  "eval_batch_size": 2,
  "logging_steps": 20,
  "skip_eval": false,
  "load_best_model_at_end": true,
  "keep_best_n": 3,
  "checkpoint_metric": "eval_accuracy",
  "balance_datasets": true,
  "random_crop": true,
  "use_augment": true,
  "augment": {
    "gain_prob": 0.2,
    "gain_db_range": 2.0,
    "noise_prob": 0.2,
    "noise_snr_db": 30.0
  },
  "use_weighted_layer_sum": true,
  "classifier_proj_size": 256,
  "apply_spec_augment": true,
  "mask_time_prob": 0.05,
  "mask_time_length": 10,
  "mask_time_min_masks": 2,
  "mask_feature_prob": 0.0,
  "mask_feature_length": 10,
  "mask_feature_min_masks": 0,
  "dataloader_num_workers": 0,
  "cpu_threads": 4,
  "cpu_interop_threads": 2,
  "cuda_memory_fraction": 0.6,
  "cuda_max_split_size_mb": 128,
  "auto_retry_on_oom": true,
  "oom_max_retries": 3,
  "oom_batch_reduction": 0.5,
  "oom_min_batch_size": 1,
  "seed": 42,
  "log_path": "train.log",
  "label_set": ["neutral","happy","angry","sad","disgust","fear","excited"]
}
