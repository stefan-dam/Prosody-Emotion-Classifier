{
  "model_name": "superb/hubert-base-superb-er",
  "sample_rate": 16000,
  "max_seconds": 3,
  "batch_size": 8,
  "gradient_accumulation_steps": 1,
  "learning_rate": 1e-5,
  "epochs": 5,
  "train_fraction": 0.1,
  "evaluation_strategy": "no",
  "save_strategy": "steps",
  "save_steps": 500,
  "logging_steps": 20,
  "skip_eval": true,
  "load_best_model_at_end": false,
  "keep_best_n": 0,
  "checkpoint_metric": "train_loss",
  "balance_datasets": true,
  "random_crop": false,
  "use_augment": false,
  "seed": 42,
  "log_path": "train.log",
  "label_set": ["neutral","happy","angry","sad","disgust","fear","excited"]
}
