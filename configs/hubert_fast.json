{
  "model_name": "superb/hubert-large-superb-er",
  "sample_rate": 16000,
  "max_seconds": 5,
  "batch_size": 16,
  "gradient_accumulation_steps": 2,
  "learning_rate": 5e-5,
  "fp16": true,
  "gradient_checkpointing": false,
  "epochs": 1,
  "max_steps": 20000,
  "evaluation_strategy": "steps",
  "save_strategy": "steps",
  "save_steps": 2000,
  "eval_steps": 2000,
  "logging_steps": 20,
  "skip_eval": false,
  "load_best_model_at_end": true,
  "keep_best_n": 3,
  "checkpoint_metric": "eval_accuracy",
  "balance_datasets": true,
  "random_crop": true,
  "use_augment": true,
  "augment": {
    "gain_prob": 0.2,
    "gain_db_range": 2.0,
    "noise_prob": 0.2,
    "noise_snr_db": 30.0
  },
  "seed": 42,
  "log_path": "train.log",
  "label_set": ["neutral","happy","angry","sad","disgust","fear","excited"]
}
